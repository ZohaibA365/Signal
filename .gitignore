# Secrets — never commit
.env
.env.*
!.env.example
*.pem
secrets.toml
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# dbt
dbt_signal/target/
dbt_signal/dbt_packages/
dbt_signal/logs/
dbt_signal/package-lock.yml

# Data — raw pulls stay in S3, not in git
data/
*.parquet
*.csv
# dbt seeds are source code, not data. A blanket *.csv rule silently excluded
# technologies.csv while committing its _seeds.yml, so CI found a declaration
# for a seed that did not exist and every model referencing dim_technology
# failed to compile. Local builds passed because the file was present on disk.
!dbt_signal/seeds/*.csv

# Second time the blanket rule has bitten. This one is hand-written employer
# decisions read by storage/load_dol.py - source, not data - and without it the
# sponsorship aliases work locally and silently do nothing in CI or the daily
# pipeline, which is exactly what happened: posting coverage measured 59.7% on a
# laptop and would have stayed at 50.7% in production.
!storage/employer_aliases.csv

# Airflow
airflow.db
airflow-webserver.pid
standalone_admin_password.txt
orchestration/logs/

# Great Expectations
quality/uncommitted/

# OS / editor
.DS_Store
.vscode/
.idea/

# Airflow lives in its own venv so its pinned dependency tree cannot collide
# with dbt and pandas in the main one. Neither the venv nor its runtime state
# (metadata DB, logs, generated config) belongs in the repo.
.venv-airflow/
.airflow/

# Multi-hundred-MB government source files; re-downloadable, never committed.
data/dol/

data/dol_parquet/
data/dol_employer_summary/

# Generated static site
site/dist/
github-secrets.txt

# Snowflake key-pair auth. The private key never leaves this machine; only the
# public half is registered on the Snowflake user. Key-pair rather than password
# because the account now enforces MFA, which by design cannot be satisfied by a
# script - and because the password is recoverable from a chat transcript.
.snowflake_key.p8
.snowflake_key.pub
