<% content_for :title, "Tracker" %>

<div class="mx-auto max-w-4xl px-4 py-6 sm:py-8">
  <header class="mb-5 border-b border-gray-200 pb-4">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="text-2xl font-medium tracking-tight text-gray-900">Tracker</h1>
      <%= link_to "Browse postings →", postings_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
    </div>
    <div class="mt-2">
      <%= render "counts", counts: @counts %>
    </div>
  </header>

  <% if @applications.empty? %>
    <div class="py-16 text-center">
      <p class="text-sm text-gray-500">Nothing saved yet.</p>
      <%= link_to "Find something to apply to", postings_path,
            class: "mt-2 inline-block text-sm text-blue-600 underline hover:no-underline" %>
    </div>
  <% else %>
    <%# Grouped by status in the order a role moves through them, so the page reads
        as a pipeline rather than a list sorted by when you last touched it. %>
    <% JobApplication::STATUSES.each do |status| %>
      <% rows = @by_status[status] %>
      <% next if rows.blank? %>

      <section class="mb-7">
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-wider <%= status_text_class(status) %>">
          <%= status.humanize %> <span class="font-normal text-gray-400">(<%= rows.size %>)</span>
        </h2>
        <ul class="divide-y divide-gray-200 border-y border-gray-200">
          <% rows.each do |application| %>
            <%= render "job_applications/application", application: application %>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
</div>
