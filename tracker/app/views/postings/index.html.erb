<% content_for :title, "Postings" %>

<div class="mx-auto max-w-5xl px-4 py-6 sm:py-8">
  <header class="mb-5 border-b border-gray-200 pb-4">
    <h1 class="text-2xl font-medium tracking-tight text-gray-900">Postings</h1>
    <p class="mt-1 text-sm text-gray-500">
      From <code class="font-mono text-xs">public.apply_queue</code>, rebuilt nightly by dbt.
      Eligibility and fit are Claude's reading of the posting text.
    </p>
  </header>

  <%= render "filters", filter: @filter, states: @states, corpus: @corpus %>

  <%# Everything that changes when a filter changes lives inside this frame, so a
      keystroke replaces the list and leaves the form - and its focus - alone. %>
  <%= turbo_frame_tag "results" do %>
    <%= render "results", filter: @filter, postings: @postings, tracked: @tracked, corpus: @corpus %>
  <% end %>
</div>
