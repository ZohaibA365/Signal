{
  "name": "signal-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build && node scripts/redirect-stubs.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "parity": "esbuild lib/search.ts --format=esm --target=es2022 --outfile=lib/search.built.mjs --log-level=warning && node scripts/parity.mjs"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
