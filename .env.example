# Copy this file to .env and fill in your real keys.
# .env is gitignored and must never be committed.

# AI
ANTHROPIC_API_KEY=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=signal-data-lake

# Local Postgres warehouse (Phase 1)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=signal
POSTGRES_USER=signal
POSTGRES_PASSWORD=signal

# Snowflake (Phase 3 — leave blank until then)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=SIGNAL_DB
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=PUBLIC

# Job data sources
ADZUNA_APP_ID=
ADZUNA_API_KEY=
SERPAPI_KEY=
NEWS_API_KEY=
CRUNCHBASE_API_KEY=

# Databricks (Phase 3)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# GitHub
GITHUB_TOKEN=
